MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=campus_guard
# Exact public origin (HTTPS in production); multiple trusted origins separated by commas.
APP_ORIGIN=http://localhost:3000

# Optional bootstrap alternative; never expose this to the browser.
# ADMIN_SETUP_TOKEN=<32-or-more-random-characters>
# Optional alternate scheduler secret; GitHub Actions uses OIDC without a secret.
# CRON_SECRET=<32-or-more-random-characters>
# MONITOR_GITHUB_REPOSITORY=AnhNN11/GPS-tracker
